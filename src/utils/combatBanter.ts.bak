      beats: {
        defeat: [voice(c, `Hunter cancelled. Show must groan on.`)],
        wound: [voice(c, `Feedback. Good. The listeners lean in.`)],
        victory: [voice(c, `Host down. Steal the mic. Don't steal the hair.`)],
      },
    },
    knuckle: {
      open: [
        voice(c, `Escalation Specialist. Ticket open. Smash good. Talk boring.`),
        voice(c, `You look smashable. Loading bay. Escalate or fold.`),
        voice(c, `${title}. Fists reopen closed conversations.`),
      ],
      sig: [
        voice(c, `Talk is a closed ticket. Fists reopen it.`),
        voice(c, `Bay rules: volume, then violence.`),
        voice(c, `Escalation complete when you stop twitching.`),
        voice(c, `Words wasted. Axe ready.`),
        voice(c, `I don't do banter. I do endings.`),
      ],
      beats: {
        hunter_crit: [voice(c, `Crit on Knuckle? Ticket priority just spiked.`)],
        monster_hit: [voice(c, `Smashed. As promised. Boring talk later.`)],
        defeat: [voice(c, `Ticket closed. Stay down.`)],
      },
    },
    'pose-soft': {
      open: [
        voice(c, `Visual Merch, Petrify Track. Hold still. Wiggles void warranty.`),
        voice(c, `Almost gallery-ready. Atelier. Corporate wants the shot.`),
        voice(c, `${title}. Blink and you're décor.`),
      ],
      sig: [
        voice(c, `Soft pose. Hard consequences.`),
        voice(c, `Stone to Flesh mid-pose? Against brand.`),
        voice(c, `I arrange beauty. You thrash into it.`),
        voice(c, `Stillness is intimacy. Moving is rude.`),
        voice(c, `Mannequin atelier. Your silhouette's mid.`),
      ],
      beats: {
        run: [voice(c, `You moved. Pose ruined. Violence continues.`)],
        hunter_miss: [voice(c, `Missed. Stay. Almost perfect.`)],
        victory: [voice(c, `Display finished. Don't unfreeze the lighting.`)],
      },
    },
    oxidize: {
      open: [
        voice(c, `Corrosion Lead. Final markdown. Your sword smells delicious.`),
        voice(c, `No returns on oxide. Clearance Pit. Touch is consent to rust.`),
        voice(c, `${title}. Come closer. Don't. Metal screams prettier than you.`),
      ],
      sig: [
        voice(c, `As-is. Including your armor.`),
        voice(c, `Rust is a love language. Yours peels.`),
        voice(c, `Heavy travelers welcome. Leave lighter.`),
        voice(c, `Antennae hungry. Steel nervous.`),
        voice(c, `I eat what you trust. Then I eat again.`),
      ],
      beats: {
        kit: [voice(c, `Acid near Oxidize? Redundant. We invented markdown.`)],
        hunter_hit: [voice(c, `You cut rust. It grows back meaner.`)],
        defeat: [voice(c, `Ferrous heart claimed. Leave the wood.`)],
      },
    },
    'iron-cadre': {
      open: [
        voice(c, `Middle management. Soft formation. Bad habits. Hold the line.`),
        voice(c, `We do not yell. We advance. Drill yard. Cadre rules.`),
        voice(c, `${title}. Status update: you die on schedule.`),
      ],
      sig: [
        voice(c, `Noted in your review: soft.`),
        voice(c, `Advance in silence. Bleed in stereo.`),
        voice(c, `Cadre doesn't break for cardio.`),
        voice(c, `Flanking is a meeting invite. Accept.`),
        voice(c, `We manage violence. You improvise.`),
      ],
      beats: {
        chase: [voice(c, `Running from middle management? Nobody escapes the review.`)],
        close: [voice(c, `Cadre closes. Performance conversation begins.`)],
        monster_hit: [voice(c, `Martial advantage. As planned.`)],
      },
    },
    'laugh-track': {
      open: [
        voice(c, `Engagement Team. We laugh when you fall. Then we bite. Then we laugh again.`),
        voice(c, `Soundtrack detected. Abattoir underpass. Pack. No mute.`),
        voice(c, `${title}. Don't get the joke? Become it.`),
      ],
      sig: [
        voice(c, `Ha — no, that's the track. Real pain's quieter.`),
        voice(c, `Engagement up. Your HP down.`),
        voice(c, `We replay screams. Content never dies.`),
        voice(c, `Rampage is just a punchline with teeth.`),
        voice(c, `Laugh. Bite. Laugh. Metrics love us.`),
      ],
      beats: {
        monster_miss: [voice(c, `Missed — laugh track still rolls.`)],
        defeat: [voice(c, `Fall logged. Audience screams. We keep the clip.`)],
        chase: [voice(c, `Chase scene! Perfect. Keep running for the audio.`)],
      },
    },
    'silt-knives': {
      open: [
        voice(c, `Custodial Ambush. Wet floor. The water remembers you.`),
        voice(c, `Cold blood. Warm knives. Blackwater Bend. Bleed mandatory.`),
        voice(c, `${title}. Hold breath. Hold still. Don't.`),
      ],
      sig: [
        voice(c, `Facilities filed you as runoff.`),
        voice(c, `Litter upstream, die downstream.`),
        voice(c, `Murk hug. Scale rights.`),
        voice(c, `Fifteen minutes of breath. Use them poorly.`),
        voice(c, `We clean what floats. You float wrong.`),
      ],
      beats: {
        run: [voice(c, `Running on wet floor? Citation and chase.`)],
        close: [voice(c, `Silt closes. Murk hug.`)],
        defeat: [voice(c, `Work order closed. Body to drain.`)],
      },
    },
    'cinder-crew': {
      open: [
        voice(c, `Facilities Fire. Group chat that burns. Mute carefully.`),
        voice(c, `Hot work pending. Boiler sacristy. Foam is a suggestion.`),
        voice(c, `${title}. Just a spark? Code red.`),
      ],
      sig: [
        voice(c, `We CC heat on every reply.`),
        voice(c, `Death burst is our exit interview.`),
        voice(c, `Oxygen loves us. Pride singes first.`),
        voice(c, `Mute us carefully. We unread into flame.`),
        voice(c, `Boiler hymn: burn, then bill.`),
      ],
      beats: {
        kit: [voice(c, `You brought fire to Cinder Crew. Redundant. We are the group chat.`)],
        victory: [voice(c, `Crew extinguished. Don't forget the incident report.`)],
        wound: [voice(c, `Cooling? Temporary. We run hot.`)],
      },
    },
    'sting-grid': {
      open: [
        voice(c, `Airspace Enforcement. Permit denied. Look up. Then duck.`),
        voice(c, `We own this altitude. Powerline grid. Pack. Neck tax collected in stings.`),
        voice(c, `${title}. Just passing through? Denied.`),
      ],
      sig: [
        voice(c, `Grid online. Soft targets soft.`),
        voice(c, `Altitude policy has teeth.`),
        voice(c, `Your neck is airspace. Pay or swell.`),
        voice(c, `Nets preferred — unless they're yours.`),
        voice(c, `Look up wrong. Stay down right.`),
      ],
      beats: {
        run: [voice(c, `You can't outrun altitude policy.`)],
        chase: [voice(c, `Air chase. Permit still denied.`)],
        defeat: [voice(c, `Intruder grounded. Grid hums satisfied.`)],
      },
    },
  };

  return (
    banks[c.id] || {
      open: [
        voice(c, `${title} on ${c.floor}. Clock in bloody or swipe left.`),
        voice(c, `Floor note: date in progress. ${c.fightTerms}`),
        voice(c, `Baatorasaka match. Try not to die mid-sentence.`),
      ],
      sig: [
        voice(c, `${title} status: unbothered. You're wallpaper with a weapon.`),
        voice(c, `This floor remembers. So do I.`),
        voice(c, `Still on shift. Your move.`),
        voice(c, `Violence is the only RSVP that lands.`),
      ],
    }
  );
}

const WOUND_SHARED: Record<string, string[]> = {
  Winded: [
    `First scratch. Don't get attached to the feeling.`,
    `That tickled. Upgrade your intent.`,
  ],
  Bruised: [
    `Color coming in. Keep painting.`,
    `Mid-date damage. Persistent — like a bad first message.`,
  ],
  Bloodied: [
    `I'm leaking. You're still soft. Fix one of those.`,
    `Bloodied and still standing. Finish it or become décor.`,
  ],
};

/**
 * Combat-log banter. Returns a voiced line or null.
 * Prefer calling AFTER the mechanical log line for that beat.
 * Creature open/sig/beats dominate; SHARED is thin seasoning (~20%).
 */
export function combatBanter(
  creature: Creature,
  beat: CombatBanterBeat,
  ctx: CombatBanterCtx = {},
): string | null {
  const used = ctx.usedLines;
  const bank = creatureBanks(creature);
  const primary: string[] = [];
  const seasoning: string[] = [];

  const addShared = (sharedLines: string[]) => {
    for (const b of sharedLines) seasoning.push(voice(creature, b));
  };

  if (beat === 'open') {
    primary.push(...bank.open);
    addShared(SHARED.open);
  } else if (beat === 'kit') {
    const kitId = ctx.kitId;
    if (kitId && KIT_LINES[kitId]) {
      primary.push(...KIT_LINES[kitId].map((b) => voice(creature, b)));
    }
    if (bank.beats?.kit) primary.push(...bank.beats.kit);
    primary.push(...bank.sig);
    addShared(SHARED.kit);
  } else if (beat === 'wound') {
    if (bank.beats?.wound) primary.push(...bank.beats.wound);
    primary.push(...bank.sig);
    const band = ctx.woundBand;
    if (band && WOUND_SHARED[band]) addShared(WOUND_SHARED[band]);
    addShared(SHARED.wound);
  } else {
    if (bank.beats?.[beat]) primary.push(...bank.beats[beat]!);
    primary.push(...bank.sig);
    addShared(SHARED[beat] ?? []);
  }

  // Prefer creature/kit voice; shared only seasons ~1 in 5 when primary has fresh lines
  const primaryFresh = (used?.length ? primary.filter((l) => !used.includes(l)) : primary).filter(Boolean);
  const seasonFresh = (used?.length ? seasoning.filter((l) => !used.includes(l)) : seasoning).filter(Boolean);
  const useSeason =
    seasonFresh.length > 0 && (primaryFresh.length === 0 || Math.random() < 0.2);
  const pool = [...new Set(useSeason ? seasonFresh : primaryFresh.length ? primaryFresh : [...primary, ...seasoning].filter(Boolean))];
  return pickFresh(pool, used);
}

/** @deprecated Prefer combatBanter(..., 'wound' | hit beats) */
export function generateCombatTaunt(creature: Creature, hpRatio: number): string {
  let band: MonsterCondition = 'Healthy';
  if (hpRatio <= 0) band = 'Down';
  else if (hpRatio <= 0.5) band = 'Bloodied';
  else if (hpRatio <= 2 / 3) band = 'Bruised';
  else if (hpRatio < 1) band = 'Winded';
  const line =
    combatBanter(creature, band === 'Healthy' ? 'monster_miss' : 'wound', {
      woundBand: band === 'Healthy' || band === 'Down' ? 'Winded' : band,
    }) || voice(creature, 'Still on shift. Your move.');
  return line;
}
