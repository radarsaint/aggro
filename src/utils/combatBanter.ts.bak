import type { Creature, KitId } from '../types';
import type { MonsterCondition } from './condition';

export type CombatBanterBeat =
  | 'open'
  | 'hunter_hit'
  | 'hunter_miss'
  | 'hunter_crit'
  | 'kit'
  | 'monster_hit'
  | 'monster_miss'
  | 'wound'
  | 'run'
  | 'chase'
  | 'close'
  | 'victory'
  | 'defeat';

export interface CombatBanterCtx {
  kitId?: KitId;
  /** New wound band after a worsen transition */
  woundBand?: MonsterCondition;
  /** Exact lines already used this fight */
  usedLines?: string[];
  hunterName?: string;
}

function pick<T>(arr: T[]): T {
  return arr[Math.floor(Math.random() * arr.length)];
}

function pickFresh(lines: string[], used?: string[]): string | null {
  if (!lines.length) return null;
  const pool = used?.length ? lines.filter((l) => !used.includes(l)) : lines;
  return pick(pool.length ? pool : lines);
}

function role(creature: Creature): string {
  return creature.jobTitle || 'Floor Associate';
}

function floorShort(creature: Creature): string {
  return creature.floor.split('—')[0].trim();
}

function voice(creature: Creature, body: string): string {
  return `${creature.name}: ${body}`;
}

/** Shared banks — thin seasoning only. Creature sig owns the fight. */
